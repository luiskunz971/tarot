ANTHROPIC_API_KEY=tu-api-key-aca
# Solo si tu API key no está asociada a un workspace:
ANTHROPIC_WORKSPACE_ID=

# Contraseña del panel /admin (el usuario puede ser cualquiera)
ADMIN_PASSWORD=

# Base de datos (Turso). Sin esto, en local se usa el archivo local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Voz argentina (Azure Speech). Sin esto se usa la voz del navegador.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Opcional: es-AR-ElenaNeural (por defecto) o es-AR-TomasNeural
AZURE_SPEECH_VOICE=
